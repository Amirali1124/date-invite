# متغیرهای محیطی — این فایل را به .env کپی کن و مقدارها را بگذار.
# .env در .gitignore است و هرگز نباید به گیت‌هاب برود.

# توکنی که @BotFather می‌دهد — ربات را می‌سازد و به پیام‌ها گوش می‌دهد
TELEGRAM_BOT_TOKEN=

# شناسهٔ عددی چت خودت (از @userinfobot بگیر) — نتیجه مستقیم به تو می‌رسد
OWNER_CHAT_ID=

# لینک سایتی که ربات داخل پیام می‌فرستد
SITE_URL=https://amirali1124.github.io/date-invite

# اختیاری: اگر سرور پشت دامنهٔ دیگری است، آدرس عمومی‌اش را اینجا بگذار.
# خالی بگذاری، خودش از دامنهٔ Render ساخته می‌شود.
PUBLIC_ORIGIN=
